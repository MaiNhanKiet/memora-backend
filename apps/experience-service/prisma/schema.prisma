// Introspected from database memora. Experience owns memory and platform only.
// Logical IDs such as user_id and order_id are not foreign keys to other services.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["memory", "platform"]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model access_grants {
  id                    String       @id(map: "pk_memory_access_grants") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memory_card_id        String       @db.Uuid
  grantee_user_id       String?      @db.Uuid
  grantee_email         String       @db.Citext
  status                String       @default("PENDING") @db.VarChar(20)
  invitation_token_hash String?      @db.VarChar(128)
  invite_expires_at     DateTime?    @db.Timestamptz(6)
  accepted_at           DateTime?    @db.Timestamptz(6)
  linked_to_account_at  DateTime?    @db.Timestamptz(6)
  revoked_by_user_id    String?      @db.Uuid
  revoked_at            DateTime?    @db.Timestamptz(6)
  last_accessed_at      DateTime?    @db.Timestamptz(6)
  created_at            DateTime     @default(now()) @db.Timestamptz(6)
  memory_cards          memory_cards @relation(fields: [memory_card_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_memory_access_grants_memory_card_id")

  @@schema("memory")
}

