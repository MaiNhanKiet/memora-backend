NODE_ENV=development

# API Gateway
API_GATEWAY_PORT=3000
SWAGGER_ENABLED=true
# Comma-separated browser origins. Empty = same-origin/curl only (no wildcard).
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# FRONTEND_ORIGIN=http://localhost:5173
# TRUST_PROXY=false
# Cloudflare/K3s: TRUST_PROXY=1 (never trust every forwarded hop)
# AUTH_THROTTLE_DISABLED=false

# IAM gRPC Server
IAM_GRPC_HOST=0.0.0.0
IAM_GRPC_PORT=50051
# HTTP liveness/readiness for Docker/K3s. Bind 0.0.0.0 in-cluster.
# IAM_HEALTH_HOST=127.0.0.1
# IAM_HEALTH_PORT=5051

# Gateway -> IAM gRPC Client
# Local: localhost:50051
# Docker Compose: iam-service:50051
# Variables already injected into the process override this file.
IAM_GRPC_URL=localhost:50051

# Internal Gateway → IAM caller token (NOT the JWT HS256 secret)
IAM_INTERNAL_GRPC_SECRET=replace-with-a-long-random-internal-secret

# Gateway auth cookies (optional; defaults shown)
# AUTH_REFRESH_COOKIE_NAME=memora_refresh
# AUTH_CSRF_COOKIE_NAME=memora_csrf
# AUTH_COOKIE_PATH=/api/v1/auth
# AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_DOMAIN=

# Local / Arcane infra compose (deploy/infra/compose.yaml)
POSTGRES_USER=memora
POSTGRES_PASSWORD=replace-with-postgres-password
POSTGRES_DB=memora

# IAM PostgreSQL (schema iam, database memora)
# After Postgres is up: npm run prisma:iam:bootstrap  (migrate deploy + system roles seed)
IAM_DATABASE_URL=postgresql://memora:replace-with-postgres-password@127.0.0.1:5432/memora?schema=iam

# Commerce gRPC bind address. Not a client target.
COMMERCE_GRPC_HOST=0.0.0.0
COMMERCE_GRPC_PORT=50052
# HTTP liveness/readiness. Local default is loopback.
# In Docker, bind 0.0.0.0 on memora-network and do not publish 50052 or 5052.
# COMMERCE_HEALTH_HOST=127.0.0.1
# COMMERCE_HEALTH_PORT=5052
# Same PostgreSQL instance and database memora.
# Schemas: catalog, pricing, inventory, design, ordering.
# 27 Prisma models are mapped. Prisma Client can be generated.
# Business repositories are not implemented. Runtime uses one pg pool for the database probe.
# Local: 127.0.0.1. Docker DNS: postgres:5432.
# Use a least-privilege role. Do not use the PostgreSQL superuser in production.
COMMERCE_DATABASE_URL=postgresql://commerce:replace-with-commerce-password@127.0.0.1:5432/memora

# Operations gRPC bind address. Not a client target.
OPERATIONS_GRPC_HOST=0.0.0.0
OPERATIONS_GRPC_PORT=50053
# HTTP liveness/readiness. Local default is loopback.
# In Docker, bind 0.0.0.0 on memora-network and do not publish 50053 or 5053.
# OPERATIONS_HEALTH_HOST=127.0.0.1
# OPERATIONS_HEALTH_PORT=5053
# Same PostgreSQL instance and database memora.
# Schemas: personalization, production, fulfillment, after_sales.
# 30 Prisma models are mapped. Prisma Client can be generated.
# Business repositories are not implemented. Runtime uses one pg pool for the database probe.
# Local: 127.0.0.1. Docker DNS: postgres:5432.
# Use a least-privilege role. Do not use the PostgreSQL superuser in production.
OPERATIONS_DATABASE_URL=postgresql://operations:replace-with-operations-password@127.0.0.1:5432/memora

# Experience gRPC bind address. Not a client target.
EXPERIENCE_GRPC_HOST=0.0.0.0
EXPERIENCE_GRPC_PORT=50054
# HTTP liveness/readiness. Local default is loopback.
# In Docker, bind 0.0.0.0 on memora-network and do not publish 50054 or 5054.
# EXPERIENCE_HEALTH_HOST=127.0.0.1
# EXPERIENCE_HEALTH_PORT=5054
# Same PostgreSQL instance and database memora.
# Schemas: memory, platform.
# 11 Prisma models are mapped. Prisma Client can be generated.
# Business repositories are not implemented. Runtime uses one pg pool for the database probe.
# Local: 127.0.0.1. Docker DNS: postgres:5432.
# Use a least-privilege role. Do not use the PostgreSQL superuser in production.
EXPERIENCE_DATABASE_URL=postgresql://experience:replace-with-experience-password@127.0.0.1:5432/memora

# IAM JWT access token (IAM process only; do not commit real secrets)
IAM_JWT_SECRET=replace-with-a-long-random-secret-value
IAM_JWT_ISSUER=memora-iam
IAM_JWT_AUDIENCE=memora-api
IAM_JWT_ACCESS_TTL_SECONDS=900

# IAM Redis refresh sessions (IAM process only; bind localhost in development)
REDIS_PASSWORD=replace-with-redis-password
IAM_REDIS_HOST=127.0.0.1
IAM_REDIS_PORT=6379
IAM_REDIS_PASSWORD=replace-with-redis-password
IAM_REDIS_DB=0
IAM_REFRESH_PEPPER=replace-with-a-long-random-pepper-value
IAM_REFRESH_IDLE_TTL_SECONDS=604800
IAM_REFRESH_ABSOLUTE_TTL_SECONDS=2592000
IAM_REFRESH_REUSE_GRACE_SECONDS=10

# IAM email. Registration codes expire after 5 minutes.
# Verify template variable: OTP. Reset template variable: RESET_LINK.
IAM_PURPOSE_TOKEN_PEPPER=replace-with-a-long-random-pepper-value
IAM_EMAIL_ACTION_BASE_URL=https://app.example.invalid
RESEND_EMAIL_API_KEY=replace-with-resend-api-key
RESEND_TEMPLATE_VERIFY=replace-with-published-template-id
RESEND_TEMPLATE_RESET=password-reset
EMAIL_FROM=Memora <noreply@example.com>
IAM_EMAIL_VERIFICATION_TTL_SECONDS=300
IAM_EMAIL_VERIFICATION_COOLDOWN_SECONDS=60
IAM_PASSWORD_RESET_TTL_SECONDS=1800
IAM_PASSWORD_RESET_COOLDOWN_SECONDS=60
IAM_EMAIL_RATE_LIMIT_MAX=5
IAM_EMAIL_RATE_LIMIT_WINDOW_SECONDS=3600

# Google OAuth (optional). Leave GOOGLE_OAUTH_ENABLED unset/false to boot without Google.
# Gateway: GET /api/v1/auth/google and /api/v1/auth/google/callback
# IAM: GOOGLE_CLIENT_ID is required to verify ID tokens when AuthenticateGoogle is called.
# GOOGLE_OAUTH_ENABLED=false
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
# GOOGLE_OAUTH_STATE_TTL_SECONDS=600
# GOOGLE_OAUTH_STATE_SECRET=replace-with-a-long-random-oauth-state-secret
# FRONTEND_AUTH_SUCCESS_URL=http://localhost:5173/auth/callback
# FRONTEND_AUTH_FAILURE_URL=http://localhost:5173/auth/error
# Callback failures redirect here with ?error= a stable code:
# email_already_registered, account_unavailable, google_email_unverified,
# google_unavailable, registration_unavailable, google_cancelled, oauth_denied,
# oauth_state_invalid, oauth_state_expired, oauth_rejected, rate_limited,
# sign_in_failed, google_account_in_use, google_email_already_registered,
# google_already_linked, link_unavailable, credential_incorrect
# A different Google email redirects with error=google_email_confirmation_required
# and confirmationId. Confirm with POST /api/v1/auth/google/link and that confirmationId.

# Shared cache/queue Redis — opt-in per service. Gateway and IAM do not load these.
# Dev may share the IAM Redis process with separate DBs. Production should use
# dedicated endpoints: IAM sessions, general cache, and BullMQ (noeviction).
# Do not reuse IAM_REDIS_PASSWORD as the default for every service.
# CACHE_REDIS_HOST=127.0.0.1
# CACHE_REDIS_PORT=6379
# CACHE_REDIS_PASSWORD=replace-with-cache-redis-password
# CACHE_REDIS_DB=1
# CACHE_REDIS_CLUSTER=false
# Cluster mode: set true and CACHE_REDIS_DB=0; Cluster has no SELECT DB 1/2.
# CACHE_KEY_PREFIX=memora:cache
# QUEUE_REDIS_HOST=127.0.0.1
# QUEUE_REDIS_PORT=6379
# QUEUE_REDIS_PASSWORD=replace-with-queue-redis-password
# QUEUE_REDIS_DB=2
# QUEUE_REDIS_CLUSTER=false
# QUEUE_PREFIX=memora:bull
# QUEUE_DEFAULT_ATTEMPTS=3
# QUEUE_DEFAULT_BACKOFF_MS=1000
