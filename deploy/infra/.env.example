# Copied to /opt/memora/secrets/infra.env by the host helper (never commit real values).
POSTGRES_USER=memora
POSTGRES_PASSWORD=replace-with-csprng-postgres-password
POSTGRES_DB=memora
REDIS_PASSWORD=replace-with-csprng-redis-password-min-16
TAILSCALE_IPV4=100.78.222.34
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
# Garage object storage (D-P-08). Generate: openssl rand -hex 32
GARAGE_RPC_SECRET=replace-with-64-hex-chars
GARAGE_ADMIN_TOKEN=replace-with-csprng-admin-token
# Access key id: GK + 24 hex chars (openssl rand -hex 12). Secret: 64 hex chars.
GARAGE_ACCESS_KEY_ID=GKreplace-with-24-hex-chars
GARAGE_SECRET_ACCESS_KEY=replace-with-64-hex-chars
GARAGE_BUCKET=memora-personalization
# Mosquitto MQTT broker (D-P-07). Users are built from these values on every container start.
# MQTT_OPERATIONS_PASSWORD = OPERATIONS_MQTT_PASSWORD in operations.env (openssl rand -hex 24).
# MQTT_DEVICE_USERS: deviceCode:password pairs, comma-separated; each password >= 16 chars.
MOSQUITTO_IMAGE=eclipse-mosquitto:2.0.21
MQTT_OPERATIONS_PASSWORD=replace-with-48-hex-chars
MQTT_DEVICE_USERS=esp32-store-01:replace-with-device-password
