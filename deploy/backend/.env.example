# Written to /opt/memora/backend/release.env by memora-deploy (images + SHA).
# Do not use :latest.

MEMORA_RELEASE_SHA=replace-with-40-char-git-sha
GATEWAY_IMAGE=ghcr.io/mainhankiet/memora-api-gateway@sha256:replace-with-gateway-digest
IAM_IMAGE=ghcr.io/mainhankiet/memora-iam-service@sha256:replace-with-iam-digest
MIGRATE_IMAGE=ghcr.io/mainhankiet/memora-iam-migrate@sha256:replace-with-migrate-digest
# Domain images are optional. Default deploy does not set MEMORA_DOMAIN_SERVICES.
# COMMERCE_IMAGE=ghcr.io/mainhankiet/memora-commerce-service@sha256:replace-with-commerce-digest
# OPERATIONS_IMAGE=ghcr.io/mainhankiet/memora-operations-service@sha256:replace-with-operations-digest
# EXPERIENCE_IMAGE=ghcr.io/mainhankiet/memora-experience-service@sha256:replace-with-experience-digest

TAILSCALE_IPV4=100.78.222.34
