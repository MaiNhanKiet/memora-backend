NODE_ENV=production
API_GATEWAY_PORT=3000
SWAGGER_ENABLED=false
IAM_GRPC_URL=iam-service:50051
IAM_INTERNAL_GRPC_SECRET=replace-with-32-plus-char-shared-grpc-secret
TRUST_PROXY=1
AUTH_COOKIE_SAMESITE=lax
# FRONTEND_ORIGIN=https://app.example.com
# CORS_ALLOWED_ORIGINS=https://app.example.com
# GOOGLE_OAUTH_ENABLED=false
# Domain services. Set URL and secret together, only when the Gateway calls the service.
# The secret must equal <SERVICE>_INTERNAL_GRPC_SECRET in that service's env file.
# COMMERCE_GRPC_URL=commerce-service:50052
# COMMERCE_INTERNAL_GRPC_SECRET=replace-with-32-plus-char-commerce-grpc-secret
# OPERATIONS_GRPC_URL=operations-service:50053
# OPERATIONS_INTERNAL_GRPC_SECRET=replace-with-32-plus-char-operations-grpc-secret
# EXPERIENCE_GRPC_URL=experience-service:50054
# EXPERIENCE_INTERNAL_GRPC_SECRET=replace-with-32-plus-char-experience-grpc-secret
