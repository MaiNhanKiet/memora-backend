NODE_ENV=production
EXPERIENCE_GRPC_HOST=0.0.0.0
EXPERIENCE_GRPC_PORT=50054
EXPERIENCE_HEALTH_HOST=0.0.0.0
EXPERIENCE_HEALTH_PORT=5054
# Docker DNS on memora-network. Do not publish 50054 or 5054 on the host.
# Runtime role experience_app. Password comes from the secret store, not from git.
EXPERIENCE_DATABASE_URL=postgresql://experience_app:replace-with-experience-app-password@postgres:5432/memora
