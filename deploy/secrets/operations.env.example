NODE_ENV=production
OPERATIONS_GRPC_HOST=0.0.0.0
OPERATIONS_GRPC_PORT=50053
OPERATIONS_HEALTH_HOST=0.0.0.0
OPERATIONS_HEALTH_PORT=5053
# Docker DNS on memora-network. Do not publish 50053 or 5053 on the host.
# Runtime role operations_app. Password comes from the secret store, not from git.
OPERATIONS_DATABASE_URL=postgresql://operations_app:replace-with-operations-app-password@postgres:5432/memora
