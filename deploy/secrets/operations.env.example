NODE_ENV=production
OPERATIONS_GRPC_HOST=0.0.0.0
OPERATIONS_GRPC_PORT=50053
OPERATIONS_HEALTH_HOST=0.0.0.0
OPERATIONS_HEALTH_PORT=5053
# Docker DNS on memora-network. Do not publish 50053 or 5053 on the host.
# Runtime role operations_app. Password comes from the secret store, not from git.
OPERATIONS_DATABASE_URL=postgresql://operations_app:replace-with-operations-app-password@postgres:5432/memora
# Gateway -> operations-service caller secret. Set the same value in gateway.env.
OPERATIONS_INTERNAL_GRPC_SECRET=replace-with-32-plus-char-operations-grpc-secret
# Operations -> commerce-service (Consent reads order facts). Same secret as COMMERCE_INTERNAL_GRPC_SECRET in commerce.env.
COMMERCE_GRPC_URL=commerce-service:50052
COMMERCE_INTERNAL_GRPC_SECRET=replace-with-32-plus-char-commerce-grpc-secret
# Consent policy version the FE shows (required outside development, max 50 chars).
OPERATIONS_CONSENT_POLICY_VERSION=replace-with-consent-policy-version

# Object storage (Garage S3, D-P-08). Same key as GARAGE_ACCESS_KEY_ID / GARAGE_SECRET_ACCESS_KEY in memora-infra.
# Not read by code yet; validation is added with the first upload/capture API.
OPERATIONS_OBJECT_STORAGE_ENDPOINT=http://garage:3900
OPERATIONS_OBJECT_STORAGE_REGION=garage
OPERATIONS_OBJECT_STORAGE_BUCKET=memora-personalization
OPERATIONS_OBJECT_STORAGE_ACCESS_KEY_ID=GKreplace-with-garage-access-key-id
OPERATIONS_OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-garage-secret-key
