NODE_ENV=production
COMMERCE_GRPC_HOST=0.0.0.0
COMMERCE_GRPC_PORT=50052
COMMERCE_HEALTH_HOST=0.0.0.0
COMMERCE_HEALTH_PORT=5052
# Docker DNS on memora-network. Do not publish 50052 or 5052 on the host.
# Runtime role commerce_app. Password comes from the secret store, not from git.
COMMERCE_DATABASE_URL=postgresql://commerce_app:replace-with-commerce-app-password@postgres:5432/memora
